{
  "name": "geo-tracker-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "demo:realtime": "tsx src/demo/realtime-demo.ts",
    "test:integration": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "kysely": "^0.28.17",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
